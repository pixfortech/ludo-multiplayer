# Copy to .env (git-ignored) and adjust. Never commit real credentials.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Behind N trusted reverse proxies (TLS terminator, load balancer), set N so
# rate limits use the X-Forwarded-For client address. 0 = direct connections.
TRUST_PROXY_HOPS=0
# Required: the server will not start without a reachable, migrated database
# (run `npm run db:migrate` first). Local development database matching
# docker-compose.yml; dev-only password.
DATABASE_URL=postgres://ludo:ludo_dev_only@127.0.0.1:5432/ludo
# Tests never use DATABASE_URL. They start a private PostgreSQL from local
# binaries, or use a throwaway database on this server if set:
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Directory containing initdb and pg_ctl, if the tests cannot find it
# (Windows example: C:\Program Files\PostgreSQL\17\bin):
# PG_BIN_DIR=/usr/lib/postgresql/17/bin
# Make missing PostgreSQL fail the test run instead of skipping (CI):
# REQUIRE_POSTGRES_TESTS=1
