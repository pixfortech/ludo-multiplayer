{
  "name": "ludo-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Server-authoritative multiplayer Ludo platform for 2–15 players.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared-types",
    "packages/design-tokens",
    "packages/assets",
    "packages/board-layouts",
    "packages/game-engine",
    "apps/server",
    "apps/client"
  ],
  "scripts": {
    "dev": "npm run build:packages && concurrently -k -n server,client -c cyan,magenta \"npm run dev -w @ludo/server\" \"npm run dev -w @ludo/client\"",
    "build:packages": "npm run build -w @ludo/shared-types -w @ludo/design-tokens -w @ludo/assets -w @ludo/board-layouts -w @ludo/game-engine",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts/tsconfig.json",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "clean": "rm -rf packages/*/dist apps/*/dist",
    "design:generate": "tsx --conditions=source scripts/design-artifacts.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
