{
  "name": "@ludo/board-layouts",
  "version": "0.0.0",
  "private": true,
  "description": "Board geometry for 2\u201315 player boards, shared by the 2D and 3D renderers.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./topology": {
      "source": "./src/topology.ts",
      "types": "./dist/topology.d.ts",
      "default": "./dist/topology.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ludo/shared-types": "0.0.0",
    "@ludo/design-tokens": "0.0.0"
  }
}
