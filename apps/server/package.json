{
  "name": "@ludo/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative realtime server: rooms, sessions, persistence.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ludo/game-engine": "0.0.0",
    "@ludo/shared-types": "0.0.0",
    "express": "^5.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
